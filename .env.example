# Phulax example environment — copy to .env and fill in real values.
# Every value in THIS file is fake. Never commit .env (it is gitignored).

PHULAX_ENV=dev
LOG_LEVEL=INFO

# Local services (docker-compose)
POSTGRES_USER=phulax
POSTGRES_PASSWORD=phulax-dev-only
POSTGRES_DB=phulax
# Host ports for docker-compose — change if something already uses them
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://phulax:phulax-dev-only@localhost:5432/phulax
REDIS_URL=redis://localhost:6379/0

# Control plane API (hosted side)
API_HOST=127.0.0.1
API_PORT=8000

# Local gateway (runs inside the customer environment — ADR-0001)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_SIGNING_KEY=fake-dev-key-change-me-not-a-secret-0001
CONTROL_PLANE_URL=http://127.0.0.1:8000

# Policy bundle signing (Ed25519, base64 raw 32 bytes — T08).
# The control plane holds the PRIVATE key; the gateway is configured with
# the PUBLIC key out-of-band. There is NO checked-in default pair, not
# even for dev: `make bootstrap` generates one into your .env. To rotate:
#   python -c "from phulax_policy.signing import generate_keypair; print(*generate_keypair(), sep='\n')"
POLICY_SIGNING_KEY=
POLICY_PUBLIC_KEY=

# Raw prompt/argument/result capture is OFF by default (ADR-0002).
# Turning this on is an explicit, per-deployment decision.
CAPTURE_RAW_CONTENT=false
